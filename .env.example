NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# ห้ามใส่ NEXT_PUBLIC_ นำหน้า และห้าม commit ขึ้น Git (ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# รหัสเชิญสำหรับ "สมัครสมาชิกร้านค้า" ที่หน้าล็อกอิน (ตั้งเป็นข้อความยาวๆ เดายาก เช่น 16 ตัวขึ้นไป)
# ไม่ตั้ง = ปิดรับสมัคร (ไม่แสดงลิงก์สมัคร)  ห้ามใส่ NEXT_PUBLIC_ นำหน้า
